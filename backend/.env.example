# Copy to .env for LOCAL development only. Never commit .env. In production set these in Render's
# environment / secret manager. Use DIFFERENT values for development, staging and production.

NODE_ENV=development
PORT=8080

# Public URLs (https is mandatory in production)
FRONTEND_URL=http://localhost:5173/
API_PUBLIC_URL=http://localhost:8080

# MongoDB (required in production; leave unset locally to use the in-memory store)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/mutualx

# Generate:  openssl rand -base64 48
SESSION_SECRET=<generate-with-openssl-rand-base64-48>

# "keyId:base64(32 bytes)", newest first. Generate a key:  openssl rand -base64 32
ENCRYPTION_KEYS=k1:<generate-with-openssl-rand-base64-32>

# Meta (Instagram API with Instagram Login) — from the Meta developer dashboard
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8080/api/auth/instagram/callback

# Comma separated Instagram user ids that get the admin role (security dashboard)
ADMIN_IG_USER_IDS=

# Sessions
COOKIE_SAMESITE=lax
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8
SESSION_ROTATE_MINUTES=15
AUDIT_RETENTION_DAYS=90
TRUST_PROXY=1
LOG_LEVEL=info
